<div className="mx-arena-board">
  <div className="mx-arena-backdrop" aria-hidden="true"><i /><i /><i /></div>

  <div className={`mx-player-strip mx-player-left ${active === 'p1' ? 'active' : ''}`}>
    <div className="mx-player-strip-name">{p1Name}</div>
    <div className="mx-player-strip-state">{active === 'p1' ? 'AKTIF' : 'MENUNGGU'}</div>
  </div>
  <div className={`mx-player-strip mx-player-right ${active === 'p2' ? 'active' : ''}`}>
    <div className="mx-player-strip-name">{p2Name}</div>
    <div className="mx-player-strip-state">{active === 'p2' ? 'AKTIF' : 'MENUNGGU'}</div>
  </div>

  <div className="pile-cluster p1-x" data-side="p1" data-score={p1Score}>
    <span className="mx-zone-label">ZON X</span>
    <strong className="score-badge">{p1Score}</strong>
  </div>
  <div className="pile-cluster p1-discard" data-side="p1">
    <span className="mx-zone-label">ZON TEPI</span>
    <div className={`discard-card-slot ${p1Discard.length ? 'filled' : 'empty'}`}>
      {p1Discard.length ? <img src={cardImg(p1Discard[p1Discard.length - 1].id)} alt="" /> : null}
    </div>
  </div>
  <div className="pile-cluster master-pile" data-motion-anchor="master">
    <span className="mx-zone-label">MASTER DECK</span>
    <div className="deck-stack" />
    <strong className="deck-count">{match.deck.length}</strong>
  </div>
  <div className="pile-cluster p2-discard" data-side="p2">
    <span className="mx-zone-label">ZON TEPI</span>
    <div className={`discard-card-slot ${p2Discard.length ? 'filled' : 'empty'}`}>
      {p2Discard.length ? <img src={cardImg(p2Discard[p2Discard.length - 1].id)} alt="" /> : null}
    </div>
  </div>
  <div className="pile-cluster p2-x" data-side="p2" data-score={p2Score}>
    <span className="mx-zone-label">ZON X</span>
    <strong className="score-badge">{p2Score}</strong>
  </div>

  <section className="mx-fighter-side mx-side-left" data-side="p1">
    <aside className="mx-effect-column" aria-label="X Fighter 1 Effect Zone">
      {Array.from({ length: 5 }, (_, i) => (
        <div key={`effect-left-${i}`} className={`effect-card-slot ${p1Effects[i] ? 'filled' : 'empty'}`}>
          {p1Effects[i] ? <div className="effect-card"><img src={cardImg(p1Effects[i].id)} alt="" /></div> : <span>EFFECT</span>}
        </div>
      ))}
    </aside>
    <div className="mx-vs-module">
      <div className="mx-position-strip"><span>POSISI KAD</span><strong>X FIGHTER 1</strong></div>
      <div className="vs-battle-row">
        <div
          className={`VS mx-vs-card-slot p1 ${dropTarget === 'vs1' ? 'drop-target' : ''} ${match?.p1?.vs ? 'filled' : 'empty'}`}
          data-vs-slot="p1"
          onClick={() => onTargetVS('p1')}
          onDragOver={(e) => allowDrop(e, 'p1')}
          onDrop={(e) => dropOnVS(e, 'p1')}
        >
          {match.p1.vs ? <VSCard card={match.p1.vs} owner="p1" /> : null}
        </div>
      </div>
      <div className="mx-stat-strip" data-side="p1">
        <span>ATK <strong>{p1Atk}</strong></span>
        <span>DEF <strong>{p1Def}</strong></span>
        <span>STA <strong>{p1Sta}</strong></span>
      </div>
    </div>
  </section>

  <div className="center-clash">
    <div className="clash-stage" data-phase={phase}>
      <div className="round-slam">{roundText}</div>
      <div className="status-line">{statusText}</div>
      <div className="action-row">
        {canAttack ? <><button className="attack-btn" onClick={onAttack}>ATK</button><button className="pass-btn" onClick={onPass}>PASS</button></> : null}
      </div>
    </div>
  </div>

  <section className="mx-fighter-side mx-side-right" data-side="p2">
    <div className="mx-vs-module">
      <div className="mx-position-strip"><span>POSISI KAD</span><strong>X FIGHTER 2</strong></div>
      <div className="vs-battle-row">
        <div
          className={`VS mx-vs-card-slot p2 ${dropTarget === 'vs2' ? 'drop-target' : ''} ${match?.p2?.vs ? 'filled' : 'empty'}`}
          data-vs-slot="p2"
          onClick={() => onTargetVS('p2')}
          onDragOver={(e) => allowDrop(e, 'p2')}
          onDrop={(e) => dropOnVS(e, 'p2')}
        >
          {match.p2.vs ? <VSCard card={match.p2.vs} owner="p2" /> : null}
        </div>
      </div>
      <div className="mx-stat-strip" data-side="p2">
        <span>ATK <strong>{p2Atk}</strong></span>
        <span>DEF <strong>{p2Def}</strong></span>
        <span>STA <strong>{p2Sta}</strong></span>
      </div>
    </div>
    <aside className="mx-effect-column" aria-label="X Fighter 2 Effect Zone">
      {Array.from({ length: 5 }, (_, i) => (
        <div key={`effect-right-${i}`} className={`effect-card-slot ${p2Effects[i] ? 'filled' : 'empty'}`}>
          {p2Effects[i] ? <div className="effect-card"><img src={cardImg(p2Effects[i].id)} alt="" /></div> : <span>EFFECT</span>}
        </div>
      ))}
    </aside>
  </section>
</div>